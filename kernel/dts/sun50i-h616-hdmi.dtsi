// H616 Display Engine + HDMI overlay for Linux 6.6.30
//
// Adds nodes absent from mainline sun50i-h616.dtsi:
//   de_clk  (DE33 internal CCU)  @ 0x01000000
//   mixer0                        @ 0x01100000
//   tcon_top                      @ 0x05070000
//   tcon_tv                       @ 0x05051000
//   hdmi + hdmi_phy               @ 0x05500000 / 0x05510000
//
// The PWM node already exists in sun50i-h616.dtsi — do NOT add it here.
//
// Clock indices used below for DE sub-CCU (de_clk) output clocks.
// Source: include/dt-bindings/clock/sun8i-de2.h
//   CLK_BUS_MIXER0 = 0   (bus gate for mixer0)
//   CLK_BUS_MIXER1 = 1   (bus gate for mixer1 — NOT the mixer0 mod clock!)
//   CLK_BUS_WB     = 2
//   CLK_MIXER0     = 3   (rate/mod clock for mixer0)
//   CLK_MIXER1     = 4
//   CLK_WB         = 5
// Reset indices (separate namespace, same provider):
//   RST_MIXER0 = 0
//
// Clock indices used for tcon_top output clocks:
// Source: include/dt-bindings/clock/sun8i-tcon-top.h
//   CLK_TCON_TOP_TV0 = 0
//   CLK_TCON_TOP_TV1 = 1
//   CLK_TCON_TOP_DSI = 2
// (sun8i-tcon-top.h NOT included — its macros clash with H616 CCU header)
//
// HDCP: H616 has no HDCP block — CLK_HDCP / RST_BUS_HDCP do not exist in
//   sun50i-h616-ccu.h.  Only the 4 standard HDMI clocks are referenced.

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/sun50i-h616-ccu.h>
#include <dt-bindings/reset/sun50i-h616-ccu.h>

// ── display-engine virtual device (pipeline description) ─────────────────────
&{/} {
	de: display-engine {
		compatible = "allwinner,sun50i-h6-display-engine";
		allwinner,pipelines = <&mixer0>;
		status = "disabled";
	};
};

// ── DE, TCON, HDMI nodes — flat under /soc ───────────────────────────────────
&{/soc} {
	// DE33 internal clock controller.
	// Lives at the very base of the DE MMIO window (0x01000000).
	// The ccu-sun8i-de2.c driver probes this node and gates/rates
	// the downstream mixer clocks.
	de_clk: clock-controller@1000000 {
		// Prefer H616 DE clock provider when patch 002 is present.
		// Fall back to H6-compatible provider for portability.
		compatible = "allwinner,sun50i-h616-de33-clk",
			     "allwinner,sun50i-h6-de3-clk";
		reg = <0x01000000 0x10000>;
		clocks = <&ccu CLK_BUS_DE>, <&ccu CLK_DE>;
		clock-names = "bus", "mod";
		resets = <&ccu RST_BUS_DE>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	// Display mixer 0.
	// Register-compatible with H6 DE3 mixer; kernel 6.6 sun8i_mixer.c
	// matches on "allwinner,sun50i-h6-de3-mixer-0".
	mixer0: mixer@1100000 {
		compatible = "allwinner,sun50i-h6-de3-mixer-0";
		reg = <0x01100000 0x100000>;
		clocks = <&de_clk 0>, <&de_clk 3>;
		clock-names = "bus", "mod";
		resets = <&de_clk 0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			mixer0_out: port@1 {
				reg = <1>;

				mixer0_out_tcon_top_mixer0: endpoint {
					remote-endpoint = <&tcon_top_mixer0_in_mixer0>;
				};
			};
		};
	};

	tcon_top: tcon-top@6510000 {
		compatible = "allwinner,sun50i-h6-tcon-top";
		reg = <0x06510000 0x1000>;
		clocks = <&ccu CLK_BUS_TCON_TOP>,
			 <&ccu CLK_TCON_TV0>;
		clock-names = "bus", "tcon-tv0";
		clock-output-names = "tcon-top-tv0",
				     "tcon-top-tv1",
				     "tcon-top-dsi";
		resets = <&ccu RST_BUS_TCON_TOP>;
		#clock-cells = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			tcon_top_mixer0_in: port@0 {
				reg = <0>;

				tcon_top_mixer0_in_mixer0: endpoint {
					remote-endpoint = <&mixer0_out_tcon_top_mixer0>;
				};
			};

			tcon_top_mixer0_out: port@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				tcon_top_mixer0_out_tcon_tv: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&tcon_tv_in_tcon_top_mixer0>;
				};
			};

			tcon_top_hdmi_in: port@4 {
				reg = <4>;

				tcon_top_hdmi_in_tcon_tv: endpoint {
					remote-endpoint = <&tcon_tv_out_tcon_top>;
				};
			};

			tcon_top_hdmi_out: port@5 {
				reg = <5>;

				tcon_top_hdmi_out_hdmi: endpoint {
					remote-endpoint = <&hdmi_in_tcon_top>;
				};
			};
		};
	};

	tcon_tv: lcd-controller@6515000 {
		compatible = "allwinner,sun50i-h6-tcon-tv";
		reg = <0x06515000 0x1000>;
		interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_TCON_TV0>,
			 <&tcon_top 0>;
		clock-names = "ahb", "tcon-ch1";
		resets = <&ccu RST_BUS_TCON_TV0>;
		reset-names = "lcd";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			tcon_tv_in: port@0 {
				reg = <0>;

				tcon_tv_in_tcon_top_mixer0: endpoint {
					remote-endpoint = <&tcon_top_mixer0_out_tcon_tv>;
				};
			};

			tcon_tv_out: port@1 {
				reg = <1>;

				tcon_tv_out_tcon_top: endpoint {
					remote-endpoint = <&tcon_top_hdmi_in_tcon_tv>;
				};
			};
		};
	};

	// DW-HDMI transmitter.
	// H616 is register-compatible with H6; the H6 fallback compat string
	// makes sun8i_dw_hdmi.c bind on kernels that don't yet have an H616
	// entry in its OF match table.
	// H616 has NO HDCP block — do not add hdcp/hdcp-bus clock-names.
	hdmi: hdmi@6000000 {
		compatible = "allwinner,sun50i-h616-dw-hdmi",
			     "allwinner,sun50i-h6-dw-hdmi";
		reg = <0x06000000 0x10000>;
		reg-io-width = <1>;
		interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
		allwinner,force-connected;
		clocks = <&ccu CLK_BUS_HDMI>, <&ccu CLK_HDMI_SLOW>,
			 <&ccu CLK_HDMI>, <&ccu CLK_HDMI_CEC>;
		clock-names = "iahb", "isfr", "tmds", "cec";
		resets = <&ccu RST_BUS_HDMI_SUB>;
		reset-names = "ctrl";
		phys = <&hdmi_phy>;
		phy-names = "phy";
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi_in: port@0 {
				reg = <0>;

				hdmi_in_tcon_top: endpoint {
					remote-endpoint = <&tcon_top_hdmi_out_hdmi>;
				};
			};

			hdmi_out: port@1 {
				reg = <1>;
			};
		};
	};

	hdmi_phy: hdmi-phy@6010000 {
		// Prefer H616 PHY tuning tables when patch 001 is present.
		// Fall back to H6-compatible PHY profile otherwise.
		compatible = "allwinner,sun50i-h616-hdmi-phy",
			     "allwinner,sun50i-h6-hdmi-phy";
		reg = <0x06010000 0x10000>;
		clocks = <&ccu CLK_BUS_HDMI>, <&ccu CLK_HDMI_SLOW>;
		clock-names = "bus", "mod";
		resets = <&ccu RST_BUS_HDMI_SUB>;
		reset-names = "phy";
		#phy-cells = <0>;
	};

	// PWM — not present in mainline sun50i-h616.dtsi until 6.10+.
	// H616 PWM is register-compatible with H6; use H6 compatible string
	// so CONFIG_PWM_SUN4I (already selected) binds without extra patches.
	// #pwm-cells = <3>: (channel, period-ns, flags) — standard Linux PWM.
	pwm: pwm@300a000 {
		compatible = "allwinner,sun50i-h6-pwm";
		reg = <0x0300a000 0x400>;
		clocks = <&osc24M>, <&ccu CLK_BUS_PWM>;
		clock-names = "mod", "bus";
		resets = <&ccu RST_BUS_PWM>;
		#pwm-cells = <3>;
		status = "disabled";
	};
};

