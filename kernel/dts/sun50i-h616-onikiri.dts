// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
// Device Tree Source — BigTreeTech Pad 7 (CB1 module, Allwinner H616)
// Onikiri Mk.I pentesting platform

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include "sun50i-h616.dtsi"
#include "sun50i-h616-hdmi.dtsi"

/ {
	model = "Onikiri Mk.I (BigTreeTech Pad 7 CB1)";
	compatible = "bigtreetech,pad7-cb1", "allwinner,sun50i-h616";

	aliases {
		serial0 = &uart0;
		mmc0    = &mmc0;
		mmc1    = &mmc1;
		ethernet0 = &emac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		// bootargs are supplied by U-Boot boot.cmd via setenv bootargs.
		// Do NOT set bootargs here — U-Boot writes its env into the DTB's
		// chosen node, and a non-empty DTS value can conflict in some
		// U-Boot versions, causing the wrong root= to be used.
	};

	// 1 GiB DDR3L on CB1
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	// ── LEDs ───────────────────────────────────────────────────────────────

	leds {
		compatible = "gpio-leds";

		led-status {
			label = "status";
			gpios = <&pio 7 5 GPIO_ACTIVE_HIGH>;  // PH5 — green LED
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

	// ── Power regulators ───────────────────────────────────────────────────

	reg_vcc5v: regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_vcc33_wifi: regulator-vcc33-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc33-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		vin-supply = <&reg_vcc5v>;
	};

	reg_vcc_wifi_io: regulator-vcc-wifi-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc-wifi-io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		vin-supply = <&reg_vcc33_wifi>;
	};

	// ── Wi-Fi power / reset ────────────────────────────────────────────────

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc 1>;
		clock-names = "ext_clock";
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>;  // PG18 — CB1 WiFi reset
		post-power-on-delay-ms = <200>;
	};

	// ── HDMI connector (internal 7" IPS, 1024×600) ────────────────────────

	hdmi_con: connector {
		compatible = "hdmi-connector";
		type = "d";  // Micro HDMI (internal connection to LCD panel)

		// The internal 7" panel does not implement HDMI HPD (hot-plug
		// detect). Without no-hpd the driver waits for a HPD pulse that
		// never comes and never sets a display mode.
		no-hpd;

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	// ── Backlight (PWM-controlled) ─────────────────────────────────────────

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 50000 0>;
		brightness-levels = <0 16 32 48 64 80 96 128 160 192 224 255>;
		default-brightness-level = <9>;
		enable-gpios = <&pio 7 19 GPIO_ACTIVE_HIGH>;  // PH19 backlight enable
		power-supply = <&reg_dldo1>;
	};
};

// ── CPU voltage supply ────────────────────────────────────────────────────────

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

// ── R_I2C — AXP313A PMIC ───────────────────────────────────────────────────────

&r_i2c {
	pinctrl-names = "default";
	pinctrl-0 = <&r_i2c_pins>;
	status = "okay";

	axp313a: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		interrupt-controller;
		#interrupt-cells = <1>;

		regulators {
			reg_dcdc1: dcdc1 {
				regulator-name = "vdd-gpu-sys";
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-always-on;
			};

			reg_dcdc2: dcdc2 {
				regulator-name = "vdd-cpu";
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <200>;
				regulator-always-on;
			};

			reg_dcdc3: dcdc3 {
				regulator-name = "vcc-dram";
				regulator-min-microvolt = <1350000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
			};

			reg_aldo1: aldo1 {
				regulator-name = "vcc-1v8-pll";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_dldo1: dldo1 {
				regulator-name = "vcc-3v3-io";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

// ── UART0 console ──────────────────────────────────────────────────────────────

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

// ── I2C1 — Touchscreen (Goodix GT911) ─────────────────────────────────────────

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen: touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&pio>;
		interrupts = <7 4 IRQ_TYPE_EDGE_FALLING>;  // PH4
		reset-gpios   = <&pio 7 3 GPIO_ACTIVE_HIGH>;  // PH3
		irq-gpios     = <&pio 7 4 GPIO_ACTIVE_HIGH>;  // PH4
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <600>;
	};
};

// ── MMC0 — microSD card (rootfs) ───────────────────────────────────────────────

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	vmmc-supply  = <&reg_dldo1>;
	// Card detection pin not connected on CB1
	broken-cd;
	bus-width    = <4>;
	max-frequency = <50000000>;
	status = "okay";
};

// ── MMC1 — SDIO Wi-Fi (RTL8821CS) ─────────────────────────────────────────────

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins>;
	vmmc-supply  = <&reg_vcc33_wifi>;
	vqmmc-supply = <&reg_vcc_wifi_io>;
	mmc-pwrseq   = <&wifi_pwrseq>;
	bus-width    = <4>;
	max-frequency = <50000000>;
	non-removable;
	mmc-ddr-1_8v;
	status = "okay";

	rtl8189ftv: wifi@1 {
		reg = <1>;
	};
};

// ── USB OTG (DWC2) ─────────────────────────────────────────────────────────────

&usbotg {
	dr_mode = "otg";
	status = "okay";
};

&usbphy {
	usb0_vbus-supply = <&reg_vcc5v>;
	usb1_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};

// ── USB Host ────────────────────────────────────────────────────────────────────

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

// ── Ethernet (on-SoC EMAC via USB-attached PHY on some CB1 revisions) ──────────

&emac0 {
	pinctrl-names = "default";
	pinctrl-0 = <&ext_rgmii_pins>;
	phy-mode = "rgmii-id";
	phy-handle = <&ext_rgmii_phy>;
	allwinner,rx-delay-ps = <200>;
	allwinner,tx-delay-ps = <700>;
	status = "okay";
};

&mdio0 {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

// ── Display Engine & HDMI ──────────────────────────────────────────────────────

&de {
	status = "okay";
};

&hdmi {
	hvcc-supply = <&reg_dldo1>;
	status = "okay";
};

&hdmi_phy {
	/*
	 * H616 HDMI PHY needs dedicated analog rails; without these, DRM may
	 * bind but the TMDS link can stay dark (backlight only symptom).
	 */
	avdd-0v9-supply = <&reg_dcdc1>;
	avdd-1v8-supply = <&reg_aldo1>;
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

// ── PWM (backlight) ────────────────────────────────────────────────────────────

&pwm {
	status = "okay";
};
