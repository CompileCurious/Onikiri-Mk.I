# Onikiri Mk.I — Minimal kernel defconfig for Allwinner H616 (BTT CB1)
# Architecture: ARM64 / Cortex-A53
# Target: BigTreeTech Pad 7 + CB1 module
# Kernel: Linux 6.6 LTS (or later 6.x)
# Build: arm64 cross-compile

# ── Core Architecture ──────────────────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_MULTI_V8=y

# ── SMP ────────────────────────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ── Timer / Clock ──────────────────────────────────────────────────────────────
CONFIG_ARCH_TIMER=y
CONFIG_SUNXI_TIMER=y

# ── Clock Control Units ────────────────────────────────────────────────────────
CONFIG_COMMON_CLK=y
CONFIG_CLK_SUNXI=y
CONFIG_CLK_SUN50I_H6=y
CONFIG_CLK_SUN50I_H616=y

# ── Reset ──────────────────────────────────────────────────────────────────────
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SUNXI=y

# ── Power Management ───────────────────────────────────────────────────────────
CONFIG_PM=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y
# No suspend — field device stays awake
# CONFIG_SUSPEND is not set

# ── Pinctrl / GPIO ─────────────────────────────────────────────────────────────
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SUNXI=y

# ── Interrupts ─────────────────────────────────────────────────────────────────
CONFIG_IRQCHIP=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V2M=y

# ── Serial / Console ───────────────────────────────────────────────────────────
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_SUNXI=y
CONFIG_SERIAL_SUNXI_CONSOLE=y

# ── I2C (touchscreen, PMIC) ────────────────────────────────────────────────────
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y

# ── SPI ────────────────────────────────────────────────────────────────────────
CONFIG_SPI=y
CONFIG_SPI_SUNXI=y

# ── Regulator / PMIC ──────────────────────────────────────────────────────────
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y

# ── MMC / SD storage ──────────────────────────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
# CONFIG_MMC_DEBUG is not set

# ── Display Engine 3.0 (DRM) ───────────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN4I_HDMI=y
CONFIG_DRM_SUN6I_MIPI_DSI=y
# Enable KMS framebuffer for SDL2/Kivy DRM backend
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y

# ── Framebuffer ────────────────────────────────────────────────────────────────
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_LOGO is not set

# ── Touchscreen (Goodix GT911 on Pad 7) ───────────────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# ── USB OTG / DWC2 ────────────────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_OTG=y
CONFIG_USB_GADGET=y
# HID gadget for payload delivery
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_G_HID=y
# USB Ethernet gadget (RNDIS)
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# USB Mass Storage gadget
CONFIG_USB_MASS_STORAGE=y

# ── USB Networking Adapters ────────────────────────────────────────────────────
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y

# ── Wi-Fi (RTL8821CS — out-of-tree; cfg80211 framework required) ───────────────
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_RFKILL=y
CONFIG_RFKILL_GPIO=y
# Monitor mode and injection depend on driver support (RTL8821CS OOT driver)

# ── Bluetooth (RTL8821CS BT portion, HCI UART) ────────────────────────────────
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_MRVL=y
CONFIG_BT_INTEL=y
# CONFIG_BT_HCIBTUSB is not set (UART-attached on CB1)

# ── Networking ─────────────────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NET_KEY=y
CONFIG_INET6_AH=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_BRIDGE=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_CLS_U32=y
# Raw socket access needed by scapy / recon tools
CONFIG_PACKET=y
# AF_PACKET for monitor-mode frame injection
CONFIG_PACKET_DIAG=y

# ── Filesystems ────────────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── IPC / Unix sockets (supervisor IPC) ───────────────────────────────────────
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y

# ── Cryptography (minimal — no TLS stack needed at boot) ──────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
# CONFIG_CRYPTO_RSA is not set
# CONFIG_CRYPTO_DH is not set

# ── Kernel Hacking / Debug (disabled for production) ──────────────────────────
# CONFIG_KGDB is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_KERNEL is not set
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# Smaller log buffer for reduced memory footprint
CONFIG_LOG_BUF_SHIFT=14

# ── Fast-boot optimisations ────────────────────────────────────────────────────
# No module loading — all drivers compiled in (CONFIG_MODULES not set)
# CONFIG_MODULES is not set
# Disable initrd (rootfs is on MMC, squashfs mounted directly)
# CONFIG_BLK_DEV_INITRD is not set
# Reduce RCU overhead
CONFIG_RCU_BOOST=y
CONFIG_HZ_250=y
# Disable unnecessary subsystems
# CONFIG_SOUND is not set
# CONFIG_PCCARD is not set
# CONFIG_LEDS_TRIGGERS is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_DMADEVICES is not set (except what SoC requires)
CONFIG_DMAENGINES=y
CONFIG_SUN6I_DMA=y
# Disable unused filesystems
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# Disable unnecessary protocols
# CONFIG_SCTP is not set
# CONFIG_DCCP is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set

# ── Memory ─────────────────────────────────────────────────────────────────────
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_SWAP=y

# ── Scheduler ──────────────────────────────────────────────────────────────────
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# ── Debug info — disabled: reduces kernel size, removes pahole/BTF dep ────────
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_KERNEL is not set
