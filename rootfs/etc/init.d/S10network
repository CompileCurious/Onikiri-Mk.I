#!/bin/sh
# /etc/init.d/S10network — Background network initialisation for Onikiri Mk.I
# Runs as ::once from inittab — does not block supervisor startup.

# ── Wireless interface ────────────────────────────────────────────────────────
WLAN_IF=wlan0

# Bring up loopback (already done in rcS, idempotent)
ip link set lo up 2>/dev/null || true

# Bring up wlan0 if interface exists
if ip link show "${WLAN_IF}" >/dev/null 2>&1; then
    ip link set "${WLAN_IF}" up
    # wpa_supplicant only if a config exists (engagement-loaded)
    if [ -f /run/onikiri/wpa_supplicant.conf ]; then
        wpa_supplicant -B -i "${WLAN_IF}" \
            -c /run/onikiri/wpa_supplicant.conf \
            -P /run/wpa_supplicant.pid 2>/dev/null || true
        udhcpc -i "${WLAN_IF}" -b -p /run/udhcpc.pid \
            -x hostname:onikiri 2>/dev/null || true
    fi
fi

# ── USB Ethernet (hot-plug handled by uevent) ─────────────────────────────────
# eth0 will be configured by udhcpc on plug via ueventd rules.

# ── Notify supervisor that network init has run ───────────────────────────────
touch /run/onikiri/network_init_done
