#!/bin/sh
# /etc/init.d/S03boot-import — Onikiri Mk.I boot-partition inbox importer
#
# Runs after /userdata is mounted (called from rcS).
# Mounts the FAT32 boot partition (p1 = /dev/mmcblk0p1, label ONIKIRI-BOOT)
# read-only, copies user-dropped files into /userdata, then unmounts.
#
# FAT32 is readable and writable from any OS without special drivers, so p1
# acts as the "inbox" for getting files onto the device without SSH/USB.
#
# Inbox layout on the boot partition (user creates these dirs):
#
#   ONIKIRI-BOOT/
#     hid/           ← .json HID sequences, .duck/.txt/.payload scripts
#     payloads/      ← raw payload files (also parsed as HID if requested)
#     usb-device.json  ← USB HID device identity override  (see below)
#     config/        ← arbitrary .json/.conf config overrides
#
# Destination inside /userdata (persistent ext4 p3):
#
#   hid/*.json|*.duck|*.txt|*.payload  → /userdata/hid/
#   payloads/*                         → /userdata/captures/payloads/
#   usb-device.json                    → /userdata/config/usb-device.json
#   config/*.json|*.conf               → /userdata/config/
#
# usb-device.json format (choose one):
#   {"profile": "logitech_receiver"}          ← built-in profile name
#   {"vid":"0x046d","pid":"0xc52b",           ← full custom identity
#    "manufacturer":"Logitech","product":"USB Receiver","serial":"000001"}
#
# Naming without RTC
# ------------------
# Imported files keep their original filename on the boot partition.
# If a file already exists in /userdata the copy OVERWRITES it, so the
# boot partition always "wins" on the next boot — intentional for updates.
#
# Files are NOT removed from the boot partition after import; they remain
# as a reference / backup and are re-imported on every boot.  To prevent
# re-import, delete or rename the file on the boot partition.

BOOT_LABEL=ONIKIRI-BOOT
BOOT_DEV=
BOOT_MNT=/mnt/boot

log() { echo "[S03boot-import] $*" >&2; }

resolve_boot_dev() {
    # Prefer filesystem label, then common mmc fallbacks.
    if command -v blkid >/dev/null 2>&1; then
        BOOT_DEV="$(blkid -L "${BOOT_LABEL}" 2>/dev/null || true)"
    fi

    if [ -z "${BOOT_DEV}" ]; then
        for dev in /dev/mmcblk0p1 /dev/mmcblk1p1; do
            if [ -b "${dev}" ]; then
                BOOT_DEV="${dev}"
                break
            fi
        done
    fi
}

resolve_boot_dev

# ── Bail if boot device is absent (dev/emulation without real SD card) ────────
if [ -z "${BOOT_DEV}" ] || ! [ -b "${BOOT_DEV}" ]; then
    log "boot partition not found (label=${BOOT_LABEL}) — skipping boot-partition import"
    exit 0
fi

mkdir -p "${BOOT_MNT}"
if ! mount -t vfat "${BOOT_DEV}" "${BOOT_MNT}" -o rw,noatime 2>/dev/null; then
    log "Could not mount ${BOOT_DEV} — skipping boot-partition import"
    exit 0
fi

imported=0

# ── HID sequences and scripts ─────────────────────────────────────────────────
if [ -d "${BOOT_MNT}/hid" ]; then
    mkdir -p /userdata/hid
    for f in "${BOOT_MNT}/hid/"*.json \
              "${BOOT_MNT}/hid/"*.duck \
              "${BOOT_MNT}/hid/"*.txt \
              "${BOOT_MNT}/hid/"*.payload; do
        [ -f "$f" ] || continue
        fname="$(basename "$f")"
        if cp -f "$f" "/userdata/hid/${fname}" 2>/dev/null; then
            log "HID: ${fname}"
            imported=$(( imported + 1 ))
        fi
    done
fi

# ── Raw payload scripts ───────────────────────────────────────────────────────
if [ -d "${BOOT_MNT}/payloads" ]; then
    mkdir -p /userdata/captures/payloads
    for f in "${BOOT_MNT}/payloads/"*; do
        [ -f "$f" ] || continue
        fname="$(basename "$f")"
        if cp -f "$f" "/userdata/captures/payloads/${fname}" 2>/dev/null; then
            log "Payload: ${fname}"
            imported=$(( imported + 1 ))
        fi
    done
fi

# ── USB device identity override ──────────────────────────────────────────────
if [ -f "${BOOT_MNT}/usb-device.json" ]; then
    mkdir -p /userdata/config
    if cp -f "${BOOT_MNT}/usb-device.json" /userdata/config/usb-device.json 2>/dev/null; then
        log "usb-device.json imported"
        imported=$(( imported + 1 ))
    fi
fi

# ── Generic config overrides ──────────────────────────────────────────────────
if [ -d "${BOOT_MNT}/config" ]; then
    mkdir -p /userdata/config
    for f in "${BOOT_MNT}/config/"*.json \
              "${BOOT_MNT}/config/"*.conf; do
        [ -f "$f" ] || continue
        fname="$(basename "$f")"
        if cp -f "$f" "/userdata/config/${fname}" 2>/dev/null; then
            log "Config: ${fname}"
            imported=$(( imported + 1 ))
        fi
    done
fi

# ── Kernel diagnostic log ────────────────────────────────────────────────────
# Write dmesg to the FAT partition so it can be read on any PC (Windows sees
# this partition as drive ONIKIRI).  Partition is already mounted rw above.
dmesg > "${BOOT_MNT}/dmesg.txt" 2>/dev/null && {
    sync
    log "dmesg.txt written to boot partition"
} || {
    log "WARNING: dmesg write failed"
    echo "dmesg export failed from S03boot-import" > "${BOOT_MNT}/dmesg-export.failed" 2>/dev/null || true
}

umount "${BOOT_MNT}" 2>/dev/null || true

if [ "${imported}" -gt 0 ]; then
    log "Imported ${imported} file(s) from boot partition"
else
    log "No new files on boot partition"
fi
