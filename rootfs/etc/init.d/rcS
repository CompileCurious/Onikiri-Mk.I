#!/bin/sh
# /etc/init.d/rcS — Onikiri Mk.I main init script
# Executed by BusyBox init as sysinit.
# Target: < 1 second total wall time for this script.

# NOTE: do NOT use set -e here. The initramfs already moves /proc, /sys,
# /dev, /run, /tmp into the new root via mount --move before switch_root.
# Re-mounting those filesystems would fail with EBUSY and kill the entire
# init sequence. Use explicit error handling where needed instead.

# ── Mount virtual filesystems (idempotent — skip if already mounted) ──────
mountpoint -q /proc    || mount -t proc     proc     /proc     -o nosuid,noexec,nodev
mountpoint -q /sys     || mount -t sysfs    sysfs    /sys      -o nosuid,noexec,nodev
mountpoint -q /dev     || mount -t devtmpfs devtmpfs /dev      -o mode=0755,nosuid

# devpts for PTY support (needed by some tools)
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec

# tmpfs for runtime state
mountpoint -q /run     || mount -t tmpfs tmpfs /run  -o mode=0755,nosuid,nodev,size=64m
mountpoint -q /tmp     || mount -t tmpfs tmpfs /tmp  -o mode=1777,nosuid,nodev,size=32m

# ── Hostname ──────────────────────────────────────────────────────────────────
hostname -F /etc/hostname

# ── Userdata partition (/dev/mmcblk0p3) ──────────────────────────────────────
# Mount the persistent ext4 userdata partition early so the supervisor and
# all modules have access to /userdata before they start.
#
# On a fresh card (first-ever flash) p3 may not yet have an ext4 filesystem.
# S05userdata-init handles that: it creates the filesystem and directory tree
# if missing, and expands the partition to fill the card.
#
# If p3 is absent entirely (e.g. development/emulation without a real card),
# fall back to a tmpfs so the supervisor still starts — data won't persist.

USERDATA_DEV=/dev/mmcblk0p3
USERDATA_MNT=/userdata

mkdir -p "${USERDATA_MNT}"

if blkid "${USERDATA_DEV}" >/dev/null 2>&1; then
    # Device exists — S05userdata-init will create ext4 if not already present
    /etc/init.d/S05userdata-init
    mount -t ext4 "${USERDATA_DEV}" "${USERDATA_MNT}" -o noatime || {
        echo "[rcS] WARNING: failed to mount ${USERDATA_DEV} — using tmpfs" >&2
        mount -t tmpfs tmpfs "${USERDATA_MNT}" -o mode=0755,size=512m
    }
else
    echo "[rcS] WARNING: ${USERDATA_DEV} not found — using tmpfs for /userdata" >&2
    mount -t tmpfs tmpfs "${USERDATA_MNT}" -o mode=0755,size=512m
fi

# Ensure required sub-directories exist (no-op if already present)
mkdir -p \
    "${USERDATA_MNT}/hid" \
    "${USERDATA_MNT}/modules" \
    "${USERDATA_MNT}/config" \
    "${USERDATA_MNT}/captures" \
    "${USERDATA_MNT}/captures/payloads" \
    "${USERDATA_MNT}/logs"

# ── Boot-partition inbox import ───────────────────────────────────────────────
# Copy files from FAT32 p1 (accessible from any OS) into /userdata.
# HID scripts, payload files, and usb-device.json placed on the boot partition
# are imported here on every boot before the supervisor starts.
/etc/init.d/S03boot-import

# ── Loopback interface ────────────────────────────────────────────────────────
ip link set lo up

# ── Randomness seed ───────────────────────────────────────────────────────────
if [ -f /var/lib/urandom/seed ]; then
    cat /var/lib/urandom/seed > /dev/urandom
fi

# ── Create runtime directories ────────────────────────────────────────────────
mkdir -p /run/onikiri
mkdir -p /run/lock
chmod 700 /run/onikiri

# ── Load required kernel modules ─────────────────────────────────────────────
# (All core drivers are built-in; only OOT Wi-Fi driver needs explicit load)
modprobe 88x2cs 2>/dev/null || true

# ── Boot hardware check banner (backgrounded, parallel with supervisor) ─────
# Displays ONIKIRI MK.I banner and hardware status on console/fb0
# Runs in background so it doesn't block supervisor startup
if [ -x /usr/local/onikiri/boot-check.sh ]; then
    /usr/local/onikiri/boot-check.sh > /dev/console 2>&1 &
fi

# ── Done ─────────────────────────────────────────────────────────────────────
# Supervisor and network init run as separate inittab entries.
