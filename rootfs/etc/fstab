# /etc/fstab — Onikiri Mk.I
#
# Persistence model:
#   p2 (SquashFS)  — immutable system root, mounted read-only by kernel cmdline
#   p3 (ext4)      — persistent userdata, mounted r/w at /userdata
#
# All runtime state that is NOT user data uses tmpfs.
# The system root is truly immutable with no overlay/upper layer.
# Programs that need to write at runtime must use /run, /tmp, or /userdata.
#
# <device>          <mount>     <type>      <options>                   <dump> <pass>

# Root — SquashFS, read-only (kernel cmdline: root=/dev/mmcblk0p2)
/dev/mmcblk0p2      /           squashfs    ro,noatime                  0      0

# Userdata — persistent ext4 partition (survives reflash of system image).
# First-boot initialisation is handled by /etc/init.d/S05userdata-init.
/dev/mmcblk0p3      /userdata   ext4        defaults,noatime            0      2

# Virtual filesystems (mounted in rcS before fstab is processed)
proc                /proc       proc        nosuid,noexec,nodev         0      0
sysfs               /sys        sysfs       nosuid,noexec,nodev         0      0
devtmpfs            /dev        devtmpfs    mode=0755,nosuid            0      0
devpts              /dev/pts    devpts      mode=0620,gid=5             0      0
tmpfs               /run        tmpfs       mode=0755,size=64m          0      0
tmpfs               /tmp        tmpfs       mode=1777,size=32m          0      0
