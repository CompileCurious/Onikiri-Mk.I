# /etc/inittab — BusyBox init configuration for Onikiri Mk.I
#
# Boot flow:
#   sysinit  → mount filesystems, launch hardware banner in background
#   respawn  → supervisor + UI (never exits; respawned if it does)
#   once     → network init in background
#
# No getty/login — direct supervisor launch only.

# System initialization (includes backgrounded boot banner)
::sysinit:/etc/init.d/rcS

# Supervisor — respawned on exit (field-hardened)
::respawn:/usr/local/onikiri/bin/start-supervisor.sh

# Network — started after supervisor IPC is ready
::once:/etc/init.d/S10network

# Signal handlers
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
