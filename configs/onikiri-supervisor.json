{
  "socket_path": "/run/onikiri/supervisor.sock",
  "log_path": "/userdata/logs/supervisor.log",
  "engagement_data_dir": "/userdata/captures/engagements",
  "overlay_paths": [
    "/userdata/captures/engagements"
  ],
  "public_mode": true,
  "allow_live_operations": false,
  "mitm_rules_path": "/userdata/config/mitm-rules.json",
  "mitm_ca_dir": "/userdata/config/ca",
  "hid_sequence_path": "/userdata/hid/hid-sequence.json",
  "hid_payload_dir": "/userdata/captures/payloads",
  "gadget_workflow_path": "/userdata/gadget/workflows.json",
  "sd_mount": "/mnt/sd",
  "ftp": {
    "listen": "0.0.0.0",
    "port": 2121,
    "user": "onikiri",
    "password": "onikiri",
    "root": "/userdata"
  },
  "ui": {
    "listen": "0.0.0.0",
    "port": 8171,
    "kiosk_command": [
      "/usr/bin/cog",
      "--platform=drm",
      "http://127.0.0.1:8171"
    ]
  },
  "modules": [
    "wifi_recon",
    "mitm",
    "network_scanner",
    "bluetooth_recon",
    "hid_gadget",
    "gadget_automation",
    "payload_builder",
    "engagement",
    "engagement_export",
    "system_info"
  ]
}

